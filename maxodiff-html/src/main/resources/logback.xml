<?xml version="1.0" encoding="UTF-8"?>
<configuration>
<appender name="FileAppender" class="ch.qos.logback.core.FileAppender">
    <file>maxodiff.log</file>
    <append>true</append>
    <immediateFlush>true</immediateFlush>
    <encoder>
        <pattern>[%level] [HTML] [%d{yyyy-MM-dd'T'HH:mm:ss}] - %class{0} - %msg%n</pattern>
    </encoder>

</appender>

<logger name="org.springframework.boot" level="INFO"/>

<logger name="org.p2gx.maxodiff" level="TRACE" additivity="false">
    <appender-ref ref="STDOUT"/>
</logger>

<root level="info">
    <appender-ref ref="FileAppender"/>
</root>
</configuration>
